# Copy to .env and fill in your API key.
# Loaded by socratic_watchdog._load_dotenv() on %load_ext; real environment
# variables always win over anything set here.

SOCRATIC_TTS_BACKEND=espeak
SOCRATIC_LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=***

# Any OpenAI-compatible endpoint works. The path "/chat/completions" is
# appended to whatever you set, so include the version segment yourself:
#   SOCRATIC_LLM_BASE_URL=https://your-host/v1
#
# SOCRATIC_LLM_BACKEND was never read by the code — removed rather than
# left to look meaningful. See HERMES_INTEGRATION.md idea 1 for the backend
# switch it was reserving space for.
